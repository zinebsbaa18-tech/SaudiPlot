# Saudi Plot Design web adapter - local development configuration template.
# Copy to .env (gitignored) and adjust. This file must never contain secrets.

# development | test | production
SPD_ENVIRONMENT=development

# SQLite for local development (W1). PostgreSQL later is a URL change only,
# e.g. postgresql+psycopg://user:pass@host:5432/spd  (credentials go in your
# local .env, never here).
SPD_DATABASE_URL=sqlite:///./var/saudi_plot_api.db

# Anonymous session cookie (the frozen frontend has no login page).
SPD_COOKIE_NAME=spd_session
# Local-development override only - production requires true (enforced).
SPD_COOKIE_SECURE=false
# lax | strict | none
SPD_COOKIE_SAMESITE=lax

# Session lifetime in seconds (default: 7 days).
SPD_SESSION_TTL_SECONDS=604800

# Placeholder for later milestones (uploads/artifacts). Unused in W1.
SPD_STORAGE_ROOT=./var/storage

# Explicit origin list as a JSON array. Never "*": the API uses credentialed
# (cookie) requests. The Vite dev server of the frozen frontend runs on 5173.
SPD_CORS_ORIGINS=["http://localhost:5173"]

# ── Demo journey (W2) ──────────────────────────────────────────────────
# Deed upload size limit in bytes (default 20 MB).
SPD_UPLOAD_MAX_BYTES=20971520

# Server-side Gemini key. BACKEND ONLY - never expose to any browser bundle.
# Leave empty to run without AI extraction/renders (manual entry still works;
# renders report render_provider_unconfigured).
GEMINI_API_KEY=
SPD_GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
SPD_GEMINI_RENDER_MODEL=gemini-2.5-flash-image

# Advisory architectural-character knowledge base (versioned sbc_geo_knowledge
# build shipped in this repository; path is relative to backend/).
SPD_GEO_KNOWLEDGE_DB=../knowledge/geo/07_database/sbc_rules.sqlite

# Share link lifetime in seconds (default 7 days).
SPD_SHARE_TTL_SECONDS=604800
