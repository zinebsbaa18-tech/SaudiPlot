# Git LFS: large binary knowledge files only — never ordinary source code.
knowledge/**/*.gpkg filter=lfs diff=lfs merge=lfs -text
knowledge/**/*.sqlite filter=lfs diff=lfs merge=lfs -text
knowledge/**/*.sqlite3 filter=lfs diff=lfs merge=lfs -text
knowledge/**/*.db filter=lfs diff=lfs merge=lfs -text
knowledge/**/*.pdf filter=lfs diff=lfs merge=lfs -text
